                    "lowestTotalPrice": { "label": "Lowest total", "format": "number" },
                    "currency": { "label": "Currency", "format": "text" },
                    "lowestPriceProvider": { "label": "Cheapest on", "format": "text" },
                    "offersCount": { "label": "Offers", "format": "number" },
                    "priceInsight": { "label": "Price vs typical", "format": "object" },
                    "rating": { "label": "Rating", "format": "number" },
                    "reviewCount": { "label": "Reviews", "format": "number" },
                    "hotelClass": { "label": "Stars", "format": "number" },
                    "searchQuery": { "label": "Query", "format": "text" },
